#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <math.h>

int main() {
    int n;
    srand(time(NULL));

    printf("Enter board size (N): ");
    scanf("%d", &n);

    int *board = malloc(n * sizeof(int));

    while (1) {
        // 1. Generate a random starting board
        for (int i = 0; i < n; i++) board[i] = rand() % n;

        // 2. Set up a simple starting temperature
        double temp = 100.0;

        while (temp > 0.1) {
            // Count total current conflicts
            int current_conflicts = 0;
            for (int i = 0; i < n; i++) {
                for (int j = i + 1; j < n; j++) {
                    if (board[i] == board[j] || abs(board[i] - board[j]) == abs(i - j)) 
                        current_conflicts++;
                }
            }

            // If we found a solution, exit out completely
            if (current_conflicts == 0) {
                printf("\nSuccess! Solution found:\n");
                for (int i = 0; i < n; i++) printf("%d ", board[i]);
                printf("\n");
                free(board);
             printf("Bikashita Saha 1WA24CS085");
                
                return 0;
            }

            // Pick a random queen and try moving it to a random row
            int col = rand() % n;
            int old_row = board[col];
            board[col] = rand() % n;

            // Recalculate conflicts for the new test position
            int new_conflicts = 0;
            for (int i = 0; i < n; i++) {
                for (int j = i + 1; j < n; j++) {
                    if (board[i] == board[j] || abs(board[i] - board[j]) == abs(i - j)) 
                        new_conflicts++;
                }
            }

            int delta = new_conflicts - current_conflicts;

            // If the move is worse, decide whether to reject it
            if (delta > 0) {
                double probability = exp(-delta / temp);
                double random_chance = (double)rand() / RAND_MAX;
                
                if (random_chance >= probability) {
                    board[col] = old_row; // Reject the move, put it back
                }
            }

            // Cool down slightly
            temp *= 0.999;
        }
        // If it cooled down without finding a solution, the loop automatically restarts
    }
}