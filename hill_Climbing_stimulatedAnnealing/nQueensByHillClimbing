#include <stdio.h>
#include <stdlib.h>
#include <time.h>

// Count how many pairs of queens are attacking each other
int getConflicts(int board[], int n) {
    int conflicts = 0;
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            // Check same row or same diagonal
            if (board[i] == board[j] || abs(board[i] - board[j]) == abs(i - j)) {
                conflicts++;
            }
        }
    }
    return conflicts;
}

int main() {
    int n;
    srand(time(NULL));

    // Get user input for N
    printf("Enter the number of queens (N): ");
    if (scanf("%d", &n) != 1 || n < 4) {
        printf("Please enter a valid integer greater than or equal to 4.\n");
        return 1;
    }

    // Dynamically allocate board array based on user input
    int *board = (int *)malloc(n * sizeof(int));
    if (board == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    printf("Searching for a %d-Queens solution using Hill Climbing...\n", n);

    while (1) {
        // 1. Generate a completely random starting board
        for (int i = 0; i < n; i++) board[i] = rand() % n;

        int current_conflicts = getConflicts(board, n);
        int moved = 1;

        // 2. Climb the hill (make moves that reduce conflicts)
        while (moved) {
            moved = 0;

            for (int col = 0; col < n; col++) {
                int original_row = board[col];

                for (int row = 0; row < n; row++) {
                    if (row == original_row) continue;

                    board[col] = row; // Try moving the queen
                    int new_conflicts = getConflicts(board, n);

                    if (new_conflicts < current_conflicts) {
                        current_conflicts = new_conflicts;
                        moved = 1; // Success! Keep climbing from here
                        break;     
                    }
                }
                if (moved) break;
                board[col] = original_row; // Put it back if no improvement
            }
        }

        // 3. If we reached 0 conflicts, we found a perfect solution!
        if (current_conflicts == 0) {
            printf("\nSuccess! Solution found.\n");
            printf("Queen row positions per column: ");
            for (int i = 0; i < n; i++) {
                printf("%d ", board[i]);
            }
            printf("\n");
            break; 
        }
        // Otherwise, the loop automatically restarts with a fresh board
    }

    // Free the dynamically allocated memory
    free(board);
    printf("BIKASHITA SAHA 1WA24CS085");
    return 0;
    
}